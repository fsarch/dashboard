# Dockerfile.ci
# This Dockerfile assumes the build artifacts (.next and node_modules) are
# already prepared in the repository workspace (built by CI) and copies them
# into a small runtime image.

FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV production

# Install runtime dependencies
RUN apk add --no-cache cairo pango giflib jpeg libpng

# Create a non-root user
RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nextjs

# Ensure .next cache exists and has correct ownership for Next.js runtime
RUN mkdir -p /app/.next/cache && chown -R nextjs:nodejs /app/.next/cache

# Copy prebuilt artifacts from build context
# These should be produced by the CI pipeline before invoking docker build
COPY --chown=nextjs:nodejs .next/standalone ./
COPY --chown=nextjs:nodejs .next/static ./.next/static
COPY --chown=nextjs:nodejs node_modules ./node_modules

USER nextjs

EXPOSE 3000
ENV PORT 3000

CMD ["node", "server.js"]

